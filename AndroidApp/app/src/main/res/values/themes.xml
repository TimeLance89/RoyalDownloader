<resources>
    <style name="Theme.RoyalDownloader" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/royal_vault</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Theme.RoyalDownloader.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/royal_vault</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_crown_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.RoyalDownloader</item>
    </style>

    <style name="Theme.RoyalDownloader.Player" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorAccent">@android:color/white</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
    </style>
</resources>
