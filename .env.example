# Royal Downloader configuration template.
# The first-run wizard creates .env from this file automatically.

# desktop: normal Windows/macOS/Linux computer, local browser and local binding.
# nas: persistent server/container operation through start.sh or Docker Compose.
# demo: local guided simulation; no media data is downloaded or written.
ROYAL_DEPLOYMENT_MODE=nas
ROYAL_DEMO_MODE=0
HOST=0.0.0.0
OPEN_BROWSER=0
DNS_OVERRIDE=1

TZ=Europe/Berlin

# Unprivileged container identity. Use the owner of runtime/data/media on the NAS.
PUID=1000
PGID=1000

# Absolute NAS directories. Docker must have write access to both destinations.
MOVIES_HOST_DIR=/volume1/media/Filme
SERIES_HOST_DIR=/volume1/media/Serien

# Optional fallback account. The first-run wizard asks for a username and
# password and stores the password as a hash, so these two variables are only
# needed to keep an older installation reachable until an account is created
# in the interface. Leave them empty for a fresh installation.
APP_USERNAME=
APP_PASSWORD=

# Secure defaults. Set APP_REQUIRE_AUTH=false only for a deliberately open,
# trusted LAN installation. For a host-managed Cloudflare Tunnel bind to
# 127.0.0.1 and keep the origin port private. Never trust Cloudflare headers
# while port 8765 is directly reachable by untrusted clients.
ROYAL_BIND_ADDRESS=0.0.0.0
APP_REQUIRE_AUTH=true
TRUST_CLOUDFLARE_HEADERS=false

# Optional defaults for the onboarding wizard.
JELLYFIN_URL=http://192.168.1.10:8096
JELLYFIN_API_KEY=
JELLYFIN_USER_ID=
JELLYFIN_USER_NAME=
TMDB_API_KEY=
TMDB_LANGUAGE=de-DE

# Interface and translation
UI_LANGUAGE=de
# Optional self-hosted LibreTranslate base URL instead of the public fallback.
UI_TRANSLATOR_URL=
UI_TRANSLATOR_API_KEY=

# Optional provider mirror overrides.
SFLIX_BASE_URL=https://sflix.win
RIDOMOVIES_BASE_URL=https://ridomovies.su

# Serienanbieter-Schutz: 15, 30, 60 Minuten, danach exponentiell bis 6 Stunden.
SERIES_PROVIDER_COOLDOWN_INITIAL_SECONDS=900
SERIES_PROVIDER_COOLDOWN_MAX_SECONDS=21600
SERIES_PROVIDER_COOLDOWN_MULTIPLIER=2
# Gefundene Serienstrukturen der Fallback-Anbieter (Standard: 30 Minuten).
SERIES_PROVIDER_FALLBACK_CACHE_TTL_SECONDS=1800
# Temporaere Providerfehler kurz merken, ohne sie als "nicht vorhanden" zu cachen.
SERIES_PROVIDER_TRANSIENT_ERROR_TTL_SECONDS=60
# Einzelne wartende Episode während des SerienStream-Cooldowns erneut bei Fallbacks prüfen
SERIES_FALLBACK_RETRY_SECONDS=90
# Bereits aufgeloeste /r?t=-Ziele kurz wiederverwenden. Dadurch brauchen
# Download und ein direkter Retry keine zweite SerienStream-Anfrage.
SERIES_RESOLVED_LINK_CACHE_TTL_SECONDS=900
SERIES_RESOLVED_LINK_CACHE_MAX_ENTRIES=2000

# Telegram
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Seerr and Moonfin
SEERR_ENABLED=false
SEERR_URL=http://seerr:5055
SEERR_API_KEY=
SEERR_POLL_INTERVAL_SECONDS=60

# Automation
AUTO_DOWNLOAD=false
CHECK_INTERVAL_MIN=30
DL_WINDOW_START=
DL_WINDOW_END=
# Upper wall-clock budget for one movie subscription provider/hoster inventory.
# Remaining candidates are deferred to the next check rather than blocking
# series automation indefinitely.
MOVIE_SUBSCRIPTION_PROBE_BUDGET_SECONDS=75

# Public Royal Downloader repository used by the updater.
UPDATE_GITHUB_REPOSITORY=TimeLance89/RoyalDownloader
# Stable is recommended. Overnight is an opt-in development channel.
UPDATE_CHANNEL=stable
# Legacy initial-channel compatibility; saved UI selection takes precedence.
UPDATE_GITHUB_BRANCH=main
# Optional: GitHub token with read-only repository contents access.
UPDATE_GITHUB_TOKEN=
UPDATE_MODE=manual
AUTO_UPDATE_INTERVAL_HOURS=6
YTDLP_AUTO_UPDATE=true
YTDLP_UPDATE_INTERVAL_HOURS=24
YTDLP_UPDATE_START_DELAY_SECONDS=300

# Network and transfer tuning
DNS_PRIMARY=1.1.1.1
DNS_SECONDARY=9.9.9.9
HLS_CONCURRENT_FRAGMENTS=8
MP4_HTTP_CHUNK_SIZE=4M
SLOW_DOWNLOAD_MIN_KIBPS=384
SLOW_DOWNLOAD_GRACE_SECONDS=45
SLOW_DOWNLOAD_WINDOW_SECONDS=90
# Keep this much free space on the destination filesystem before starting a job.
# Set to 0 to disable the reserve check.
DOWNLOAD_MIN_FREE_GIB=5
